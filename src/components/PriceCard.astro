---
import { Check } from 'lucide-react';
import type { Plan } from '@/data/site';
import MailLink from './MailLink.astro';

interface Props {
  plan: Plan;
}
const { plan } = Astro.props;
---

<!-- Tarjeta de tarifa horizontal: detalle a la izquierda, precio y botón a la derecha -->
<article class="card flex flex-1 flex-col gap-6 p-4 shadow-card sm:flex-row sm:p-6">
  <div class="flex-1">
    <p class="text-caption text-ash uppercase">{plan.label}</p>
    <h3 class="mt-2 text-subheading font-medium">{plan.title}</h3>
    <ul class="mt-4 space-y-2 text-nav-control text-fog">
      {
        plan.features.map((feature) => (
          <li class="flex items-start gap-2">
            <Check size={16} className="mt-0.5 shrink-0 text-cloud-white" aria-hidden="true" />
            {feature}
          </li>
        ))
      }
    </ul>
  </div>
  <div
    class="flex flex-col justify-between gap-4 border-t border-graphite-edge pt-4 sm:w-56 sm:shrink-0 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-6"
  >
    <p class="whitespace-nowrap">
      <span class="text-[40px] leading-none font-medium tracking-[-1.5px]">{plan.price}</span>
      <span class="ml-1 text-nav-control text-fog">{plan.unit}</span>
    </p>
    <MailLink class:list={[plan.primary ? 'btn-pale' : 'btn-charcoal', 'w-full whitespace-nowrap']} subject={plan.mailSubject}>
      {plan.cta}
    </MailLink>
  </div>
</article>
