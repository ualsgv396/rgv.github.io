---
import { ArrowDown } from 'lucide-react';
import GmailIcon from './icons/GmailIcon';
import { SITE } from '@/data/site';
import MailLink from './MailLink.astro';
---

<section id="inicio" class="hero-glow scroll-mt-24">
  <div class="mx-auto grid max-w-[1152px] items-center gap-12 px-4 py-16 md:grid-cols-12 lg:py-32">
    <!-- Texto: alineado a la izquierda, display 60px/500, -1.5px -->
    <div class="md:col-span-7">
      <span class="eyebrow">
        <span class="size-1.5 rounded-full bg-accent shadow-[0_0_8px_var(--accent)]" aria-hidden="true"></span>
        Clases particulares
      </span>
      <h1 class="mt-6 text-[44px] leading-none font-medium tracking-[-1.5px] sm:text-display">
        {SITE.teacher}
      </h1>
      <p class="mt-4 text-subheading font-medium text-fog">{SITE.brand}</p>
      <div class="mt-8 flex flex-wrap gap-2">
        <MailLink class="btn-pale" subject="Clases particulares - Consulta">
          <GmailIcon size={18} variant={SITE.gmailIcon} /> Escríbeme por Gmail
        </MailLink>
        <a href="#asignaturas" class="btn-charcoal">
          Ver asignaturas <ArrowDown size={16} aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- Foto en marco de producto con el gráfico de polígonos luminosos -->
    <div class="relative md:col-span-5">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <span class="absolute inset-[6%] rotate-6 rounded-[20px] border border-cloud-white/25 blur-[1px]"></span>
        <span class="absolute inset-[2%] -rotate-3 rounded-[16px] border border-cloud-white/15"></span>
        <span
          class="absolute inset-[10%] rotate-12 rounded-[20px] border border-transparent opacity-60 blur-[2px]"
          style="background: linear-gradient(#0a0a0a, #0a0a0a) padding-box, linear-gradient(90deg, #ffb931 15%, #ffffff 30%, #ffffff 40%, #2e73fc 50%) border-box;"
        ></span>
      </div>
      <div class="card-interactive overflow-hidden rounded-card border border-graphite-edge bg-charcoal-surface p-2 shadow-frame">
        <img
          src="https://placehold.co/600x600/171717/a1a1a1?text=Foto"
          alt={`Foto de ${SITE.teacher}`}
          width="600"
          height="600"
          class="aspect-square w-full rounded-card object-cover grayscale transition duration-500 hover:grayscale-0"
        />
      </div>
    </div>
  </div>
</section>
